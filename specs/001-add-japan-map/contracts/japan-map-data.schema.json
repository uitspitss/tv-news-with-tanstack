{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Japan Map GeoJSON Data",
  "description": "GeoJSON FeatureCollection representing Japanese prefectures",
  "type": "object",
  "required": ["type", "features"],
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection",
      "description": "Must be FeatureCollection"
    },
    "features": {
      "type": "array",
      "description": "Array of prefecture features",
      "minItems": 47,
      "maxItems": 47,
      "items": {
        "$ref": "#/definitions/Prefecture"
      }
    }
  },
  "definitions": {
    "Prefecture": {
      "type": "object",
      "required": ["type", "properties", "geometry"],
      "properties": {
        "type": {
          "type": "string",
          "const": "Feature"
        },
        "properties": {
          "$ref": "#/definitions/PrefectureProperties"
        },
        "geometry": {
          "$ref": "#/definitions/PrefectureGeometry"
        }
      }
    },
    "PrefectureProperties": {
      "type": "object",
      "required": ["name", "code"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Prefecture name in Japanese",
          "minLength": 1,
          "examples": ["北海道", "東京都", "沖縄県"]
        },
        "code": {
          "type": "string",
          "description": "Two-digit prefecture code (01-47)",
          "pattern": "^(0[1-9]|[1-4][0-9])$",
          "examples": ["01", "13", "47"]
        },
        "region": {
          "type": "string",
          "description": "Optional region classification",
          "enum": ["北海道", "東北", "関東", "中部", "近畿", "中国", "四国", "九州・沖縄"]
        }
      }
    },
    "PrefectureGeometry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "type": "string",
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "description": "Array of linear rings",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": {
              "type": "string",
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "description": "Array of polygons",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
