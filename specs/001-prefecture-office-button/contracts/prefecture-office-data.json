{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tv-news-with-tanstack.example.com/schemas/prefecture-office-data.json",
  "title": "Prefecture Office Data",
  "description": "都道府県庁舎所在地の座標データ",
  "type": "array",
  "minItems": 47,
  "maxItems": 47,
  "items": {
    "$ref": "#/definitions/PrefectureOffice"
  },
  "definitions": {
    "PrefectureOffice": {
      "type": "object",
      "required": ["code", "name", "officeName", "lat", "lon"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^(0[1-9]|[1-4][0-9])$",
          "description": "都道府県コード（2桁、ゼロパディング）。例: \"01\", \"13\", \"47\""
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "都道府県名。例: \"北海道\", \"東京都\", \"大阪府\""
        },
        "officeName": {
          "type": "string",
          "minLength": 1,
          "description": "庁舎名。例: \"北海道庁\", \"東京都庁\", \"大阪府庁\""
        },
        "lat": {
          "type": "number",
          "minimum": -90.0,
          "maximum": 90.0,
          "description": "緯度（世界測地系WGS84、小数点以下6桁精度）"
        },
        "lon": {
          "type": "number",
          "minimum": -180.0,
          "maximum": 180.0,
          "description": "経度（世界測地系WGS84、小数点以下6桁精度）"
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    [
      {
        "code": "01",
        "name": "北海道",
        "officeName": "北海道庁",
        "lat": 43.064301,
        "lon": 141.346874
      },
      {
        "code": "13",
        "name": "東京都",
        "officeName": "東京都庁",
        "lat": 35.689487,
        "lon": 139.691706
      },
      {
        "code": "27",
        "name": "大阪府",
        "officeName": "大阪府庁",
        "lat": 34.686555,
        "lon": 135.519546
      }
    ]
  ]
}
